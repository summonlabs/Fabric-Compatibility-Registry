# Keep the repository content canonical regardless of the checking-out
# platform's autocrlf setting. Batch files stay CRLF because cmd.exe expects it.
* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.cmake text eol=lf
*.in text eol=lf
*.txt text eol=lf
CMakeLists.txt text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.bat text eol=crlf
